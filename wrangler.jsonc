{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub-portfolio-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/*","/dashboard*"]},
  "vars": {"SITE_ORIGIN":"https://5u8han.dev"},
  "triggers": {"crons":["17 3 * * *"]}
}
